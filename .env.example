# ============================================================
# 这个文件同时服务前端和服务端，按需复制成不同的文件名。
# ============================================================

# ---------- 前端：复制成 .env.local ----------
# 留空则默认走 Mock 识别，不需要后端。
# 接成员 C 的真实服务时，两项一起改：
# VITE_USE_MOCK_API=false
# VITE_API_BASE=http://localhost:8787

# ---------- 服务端：复制成 .env ----------
# 只在服务端使用，绝不提交。.env 已在 .gitignore 中。

# 百炼 API Key
DASHSCOPE_API_KEY=

# 百炼 OpenAI 兼容地址。换供应商时只改这里，代码不用动
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主模型：按赛前方案先用 qwen4-max 读题
DASHSCOPE_VISION_MODEL=qwen4-max

# 备用模型：主模型超时或 5xx 时自动重试一次，留空则关闭
DASHSCOPE_FALLBACK_MODEL=

# 单次识别超时（毫秒）。前端没有超时控制，服务端必须自己兜住
VISION_TIMEOUT_MS=25000

# 服务端口，与 vite.config.ts 的代理目标一致
PORT=8787

# 允许跨域的来源，逗号分隔；* 表示不限制（仅联调期使用）
# 上线后改成站点实际域名
ALLOWED_ORIGINS=*

# Skill 说明路径，留空则按 process.cwd() 自动查找
SKILL_PATH=
