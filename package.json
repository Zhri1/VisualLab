{
  "name": "physica-a",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && tsx src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:functions": "node scripts/sync-functions.mjs && node scripts/build-skill-module.mjs",
    "key:inject": "node scripts/inline-key.mjs inject",
    "key:restore": "node scripts/inline-key.mjs restore",
    "key:status": "node scripts/inline-key.mjs status",
    "verify:live": "node scripts/verify-live.mjs",
    "test:physics": "node --test src/physics/motion.test.ts src/physics/scene.test.ts",
    "test:ui": "node scripts/cdp-verify.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
